<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
    <div class="alert alert-danger col-6 offset-3" role="alert" >
        <h5 style="text-align: center;">ERROR!</h5>
        <h6><%= err.message %></h6>
        <% if(process.env.NODE_ENV !== "production" && err.stack) { %>
            <p style="font-size: 10px; overflow: hidden;" ><%= err.stack %></p>
        <% } %>
    </div>
</div>